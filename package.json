{
  "name": "vk-helpers",
  "version": "1.0.3",
  "description": "Helpers and utilities for creating VK mini apps",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && rollup -c",
    "test": "npm run build && node --test",
    "typecheck": "tsc --noEmit --declaration false"
  },
  "keywords": [
    "vk",
    "vkontakte",
    "mini-app",
    "helpers",
    "utils"
  ],
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^24.19.1",
    "rollup": "^4.64.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@vkontakte/vk-bridge": "^3.0.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
